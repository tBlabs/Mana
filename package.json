{
  "name": "mana",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy:clean": "rm dist.zip -f && rm ./dist -rf",
    "deploy:prepare": "npm run deploy:clean && if not exist dist mkdir dist",
    "zip": "@powershell Compress-Archive -Path ./dist/* -DestinationPath dist.zip",
    "push:prod": "curl -X POST -F file=@dist.zip https://mana.specteam.pl/deploy",
    "deploy:prod": "npm run deploy:prepare && npm run build && npm run zip && npm run push:prod && npm run deploy:clean",
    "upgrade": "npm i @tblabs/storage@latest"
  },
  "dependencies": {
    "@tblabs/storage": "^5.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
